# Firebase client config (Firebase project settings > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin: service account JSON encoded as base64. Server only.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# AI providers (server only; never prefix keys with NEXT_PUBLIC_).
# Groq is the primary provider when GROQ_API_KEY is configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gemini is used when Groq is not configured, or as a fallback for transient Groq outages.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Delivery remains disabled until Gmail OAuth + compliance controls are implemented.
EMAIL_SENDING_ENABLED=false

# Gmail API OAuth (server only). Create a Web OAuth client in Google Cloud Console.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Generate each secret locally; never commit these values.
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_OAUTH_STATE_SECRET=
