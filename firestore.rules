rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsUser(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId}/prospects/{prospectId} {
      allow read, delete: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() > 0
        && request.resource.data.companyName.size() <= 200
        && request.resource.data.status == 'new';
      allow update: if ownsUser(userId)
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() > 0
        && request.resource.data.status in ['new', 'researched', 'draft_ready', 'approved', 'rejected', 'sent', 'suppressed'];
    }

    match /users/{userId}/campaigns/{campaignId} {
      allow read, write: if ownsUser(userId);
    }
    match /users/{userId}/drafts/{draftId} {
      allow read, write: if ownsUser(userId);
    }
    match /users/{userId}/suppressions/{suppressionId} {
      allow read, write: if ownsUser(userId);
    }
  }
}